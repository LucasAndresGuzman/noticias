# Copiar a .env solo para pruebas locales. NUNCA subir el archivo .env al repositorio.
# En Render y Vercel se cargan estas variables desde el panel del servicio.

# Cadena de conexión de Neon o Supabase
DATABASE_URL=

# Usuario y contraseña de acceso a la API. Si faltan, la API rechaza todo.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Minutos entre corridas del worker (mínimo 1)
WORKER_INTERVAL_MIN=5
